# Modo del coach:
#   auto        -> usa IA si está disponible; si no, modo gratuito (recomendado)
#   gratis      -> nunca usa IA
#   suscripcion -> solo IA con tu Claude Pro/Max (Claude Code)
#   api         -> solo IA con API key de pago
COACH_MODO=auto

# Modelo al usar tu suscripción de Claude: sonnet (más rápido) u opus
COACH_MODELO_SUSCRIPCION=sonnet

# Que la IA vea capturas de tu pantalla durante la partida (solo con IA)
COACH_VISION=1
# Monitor donde juegas (1 = principal)
COACH_MONITOR=1

# Voz (1 = activada, 0 = solo texto) y velocidad de habla
COACH_VOICE=1
COACH_VOICE_RATE=185
# Segundos entre revisiones generales de la IA durante la partida
COACH_REVIEW_INTERVAL=240

# Opcional: para analizar tus partidas pasadas (opción 3 del menú)
# Key de desarrollo gratuita en https://developer.riotgames.com (caduca cada 24 h)
RIOT_API_KEY=
RIOT_ID=TuNombre#LAN
RIOT_PLATFORM=la1

# Opcional y de pago: API key de console.anthropic.com (no hace falta si usas tu suscripción)
# ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5-5
